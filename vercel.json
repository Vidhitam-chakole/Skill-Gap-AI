{
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/github/analyze",
      "destination": "/api/github/analyze"
    },
    {
      "source": "/api/github/search-users",
      "destination": "/api/github/search-users"
    },
    {
      "source": "/api/linkedin/analyze-pdf",
      "destination": "/api/linkedin/analyze-pdf"
    },
    {
      "source": "/api/linkedin/analyze",
      "destination": "/api/linkedin/analyze"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
