{
  "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/github/analyze",
      "destination": "/api/github/analyze"
    },
    {
      "source": "/api/github/search-users",
      "destination": "/api/github/search-users"
    },
    {
      "source": "/api/linkedin/analyze-pdf",
      "destination": "/api/linkedin/analyze-pdf"
    },
    {
      "source": "/api/linkedin/analyze",
      "destination": "/api/linkedin/analyze"
    },
    {
      "source": "/api/chat/message",
      "destination": "/api/chat/message"
    },
    {
      "source": "/api/chat/config",
      "destination": "/api/chat/config"
    },
    {
      "source": "/api/roadmap/build",
      "destination": "/api/roadmap/build"
    },
    {
      "source": "/api/skill-verifier/languages",
      "destination": "/api/skill-verifier/languages"
    },
    {
      "source": "/api/skill-verifier/generate",
      "destination": "/api/skill-verifier/generate"
    },
    {
      "source": "/api/skill-verifier/submit",
      "destination": "/api/skill-verifier/submit"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}