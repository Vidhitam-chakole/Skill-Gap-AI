# GitHub API token (optional but recommended to avoid rate limits)
# Get one at https://github.com/settings/tokens
GITHUB_TOKEN=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Groq API key for dynamic AI career chatbot (Get one free at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API key (optional fallback)
OPENAI_API_KEY=

# Supabase configuration for persistent, real-user data storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
